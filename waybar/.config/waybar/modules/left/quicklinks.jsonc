{
	// Accesos directos (estilo Nebulix). Para añadir uno: copia un
	// bloque, cambia el número y añádelo a "modules" del grupo.
	"custom/quicklink1": {
		"format": "\uf269",
		"tooltip-format": "Firefox",
		"on-click": "firefox"
	},
	"custom/quicklink2": {
		"format": "󰉋",
		"tooltip-format": "Archivos",
		"on-click": "thunar"
	},
	"custom/quicklink3": {
		"format": "\uf120",
		"tooltip-format": "Terminal",
		"on-click": "kitty"
	},
	"custom/quicklink4": {
		"format": "󰠮",
		"tooltip-format": "Obsidian",
		"on-click": "flatpak run md.obsidian.Obsidian"
	},

	"group/quicklinks": {
		"orientation": "horizontal",
		"modules": [
			"custom/quicklink1",
			"custom/quicklink2",
			"custom/quicklink3",
			"custom/quicklink4"
		]
	}
}
