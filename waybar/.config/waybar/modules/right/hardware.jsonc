{
	// Clic en cualquiera: btop flotante (regla en window_rules.lua)
	"cpu": {
		"format": "\uf4bc {usage}%",
		"interval": 5,
		"on-click": "kitty --class btop-float -e btop"
	},

	"memory": {
		"format": "\uefc5 {percentage}%",
		"interval": 5,
		"tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB",
		"on-click": "kitty --class btop-float -e btop"
	},

	"disk": {
		"format": "\uf0a0 {percentage_used}%",
		"path": "/",
		"interval": 60,
		"tooltip-format": "Disco /: {used} de {total} ({free} libres)",
		"on-click": "kitty --class btop-float -e btop"
	},

	// Temperatura del procesador (coretemp, "Package id 0")
	"temperature": {
		"hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
		"input-filename": "temp1_input",
		"critical-threshold": 80,
		"format": "{icon} {temperatureC}°C",
		"format-icons": ["\uf2cb", "\uf2c9", "\uf2c7"],
		"tooltip-format": "CPU: {temperatureC}°C"
	},

	// Solo se ve la CPU; RAM, disco y temperatura al pasar el ratón
	"group/hardware": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 300,
			"children-class": "hardware-child",
			"transition-left-to-right": true,
			"click-to-reveal": false
		},
		"modules": ["cpu", "memory", "disk", "temperature"]
	}
}
