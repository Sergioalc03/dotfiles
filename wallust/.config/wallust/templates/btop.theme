# Generado por wallust (templates/btop.theme). NO editar: se
# sobrescribe al cambiar de fondo. btop.conf: color_theme = "wallust"

theme[main_bg]="{{background}}"
theme[main_fg]="{{foreground}}"
theme[title]="{{foreground}}"
theme[hi_fg]="{{color4}}"
theme[selected_bg]="{{background | lighten(0.18)}}"
theme[selected_fg]="{{foreground}}"
theme[inactive_fg]="{{foreground | blend(background)}}"
theme[graph_text]="{{color7}}"
theme[meter_bg]="{{background | lighten(0.12)}}"
theme[proc_misc]="{{color5}}"

theme[cpu_box]="{{color4}}"
theme[mem_box]="{{color4}}"
theme[net_box]="{{color4}}"
theme[proc_box]="{{color4}}"
theme[div_line]="{{background | lighten(0.18)}}"

theme[temp_start]="{{color2}}"
theme[temp_mid]="{{color3}}"
theme[temp_end]="{{color1}}"

theme[cpu_start]="{{color6}}"
theme[cpu_mid]="{{color4}}"
theme[cpu_end]="{{color5}}"

theme[free_start]="{{color5}}"
theme[free_mid]="{{color4}}"
theme[free_end]="{{color6}}"

theme[cached_start]="{{color6}}"
theme[cached_mid]="{{color4}}"
theme[cached_end]="{{color5}}"

theme[available_start]="{{color3}}"
theme[available_mid]="{{color2}}"
theme[available_end]="{{color6}}"

theme[used_start]="{{color2}}"
theme[used_mid]="{{color3}}"
theme[used_end]="{{color1}}"

theme[download_start]="{{color4}}"
theme[download_mid]="{{color5}}"
theme[download_end]="{{color6}}"

theme[upload_start]="{{color3}}"
theme[upload_mid]="{{color2}}"
theme[upload_end]="{{color1}}"

theme[process_start]="{{color6}}"
theme[process_mid]="{{color4}}"
theme[process_end]="{{color5}}"
