# Sesión gráfica de Hyprland para systemd.
# Sin esto graphical-session.target nunca se activa y los servicios que
# lo exigen (xdg-desktop-portal: selector de archivos de Flatpak, tema
# oscuro, compartir pantalla) fallan con "Dependency failed".
# Lo arranca autostart.lua; al cerrar Hyprland se para con la sesión.
[Unit]
Description=Sesión de Hyprland
Documentation=man:systemd.special(7)
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
# Waybar como servicio (lo trae el paquete waybar): con Restart=on-failure
# vuelve solo si se cae (Waybar 0.15 se cierra a veces con SIGSEGV)
Wants=waybar.service
After=graphical-session-pre.target
