/* -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
 * ROFI - colores sacados del fondo de pantalla (wallust)
 * La paleta (bg, fg, acento...) está en colores.rasi, que genera
 * wallust (wallust/templates/rofi.rasi) al cambiar de fondo.
 * -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- */

@import "colores.rasi"

* {
    red: #f7768e; /* fijo: avisos */

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            600px;
    background-color: @bg;
    border:           2px;
    border-color:     @acento;
    border-radius:    12px;
    padding:          12px;
}

mainbox {
    spacing:  10px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: @surface;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @acento;
}

entry {
    placeholder:       "Buscar…";
    placeholder-color: @fg-dim;
    cursor:            text;
}

message {
    background-color: @surface;
    border-radius:    8px;
    padding:          8px 12px;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      4px;
    fixed-height: false;
    scrollbar:    false;
}

element {
    padding:       6px 10px;
    border-radius: 8px;
    spacing:       10px;
}

element normal.urgent,
element alternate.urgent {
    text-color: @red;
}

element normal.active,
element alternate.active {
    text-color: @acento2;
}

element selected.normal,
element selected.active {
    background-color: @overlay;
    text-color:       @fg;
}

element selected.urgent {
    background-color: @red;
    text-color:       @surface;
}

element-icon {
    size: 1.4em;
    vertical-align: 0.5;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

mode-switcher {
    spacing: 6px;
}

button {
    background-color: @surface;
    text-color:       @fg-dim;
    border-radius:    8px;
    padding:          6px;
}

button selected {
    background-color: @acento;
    text-color:       @bg;
}
